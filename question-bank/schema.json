{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReThink private question bank v1",
  "description": "Private authoring/backend package. Do not serve this document as a learner question payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentVersion",
    "locale",
    "title",
    "authorship",
    "status",
    "difficultyScale",
    "sources",
    "topics",
    "questions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contentVersion": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "const": "id-ID"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "authorship": {
      "const": "original-rethink"
    },
    "status": {
      "enum": [
        "draft",
        "reviewed"
      ]
    },
    "difficultyScale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "1",
        "2",
        "3"
      ],
      "properties": {
        "1": {
          "type": "string",
          "minLength": 1
        },
        "2": {
          "type": "string",
          "minLength": 1
        },
        "3": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1
    },
    "topics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/topic"
      },
      "minItems": 1
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "url",
        "alignmentStatus",
        "note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "alignmentStatus": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "phase",
        "track",
        "prerequisites",
        "alignment"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "enum": [
            "foundation",
            "E",
            "F",
            "F-advanced"
          ]
        },
        "track": {
          "enum": [
            "foundation",
            "general",
            "advanced"
          ]
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "uniqueItems": true
        },
        "alignment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceId",
            "section"
          ],
          "properties": {
            "sourceId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]*$"
            },
            "section": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "enum": [
            "a",
            "b",
            "c",
            "d"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "topicId",
        "skillId",
        "difficulty",
        "difficultyStatus",
        "format",
        "prompt",
        "options",
        "answer",
        "explanation",
        "distractors",
        "reviewStatus"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "topicId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$"
        },
        "skillId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$"
        },
        "difficulty": {
          "enum": [
            1,
            2,
            3
          ]
        },
        "difficultyStatus": {
          "const": "provisional"
        },
        "format": {
          "const": "single-choice"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "answer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "optionId"
          ],
          "properties": {
            "optionId": {
              "enum": [
                "a",
                "b",
                "c",
                "d"
              ]
            }
          }
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "distractors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "optionId",
              "misconception"
            ],
            "properties": {
              "optionId": {
                "enum": [
                  "a",
                  "b",
                  "c",
                  "d"
                ]
              },
              "misconception": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9.-]*$"
              }
            }
          },
          "minItems": 3,
          "maxItems": 3
        },
        "reviewStatus": {
          "enum": [
            "draft",
            "reviewed"
          ]
        }
      }
    }
  }
}
